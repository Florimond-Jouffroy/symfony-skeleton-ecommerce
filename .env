# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration



###> SYMFONY CORE ###
APP_ENV=dev
# Laissé vide volontairement : `setup.sh` en génère un, propre au projet, dans
# .env.local (gitignoré). Une clé partagée entre projets laisserait forger les
# cookies « remember me », les URI signées et les jetons CSRF.
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost
APP_NAME=MonSite
###< SYMFONY CORE ###

###> DOCKER / MYSQL ###
# ⚠️ `app_main` doit rester aligné sur le DATABASE_URL que `setup.sh` écrit dans
# .env.local. Symfony IGNORE .env.local quand APP_ENV=test — pour que les tests
# ne dépendent pas de la machine — et retombe donc sur la valeur ci-dessous.
# Deux noms différents ici et là, et l'environnement de test viserait une base
# que personne ne crée.
MYSQL_DATABASE=app_main
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=user
MYSQL_PASSWORD=password

# Symfony va injecter automatiquement les variables définies juste au-dessus.
#
# Hôte = nom de conteneur unique par projet (${PROJECT_NAME}-db) et NON l'alias
# de service `database` : tous les projets partagent le réseau `gateway`, où
# plusieurs conteneurs répondent à `database`. Le DNS Docker en tire un au
# hasard — une commande crée alors une base sur un serveur et la suivante en
# cherche une autre ailleurs.
#
# En environnement de test, Doctrine ajoute le suffixe `_test` (voir `when@test`
# dans config/packages/doctrine.yaml) : les bases deviennent `app_main_test` et
# `app_log_test`, que `make db-test-setup` crée.
DATABASE_URL="mysql://root:${MYSQL_ROOT_PASSWORD}@${PROJECT_NAME}-db:3306/${MYSQL_DATABASE}?serverVersion=mariadb-10.11.15&charset=utf8mb4"
###< DOCKER / MYSQL ###

###> MESSENGER ###
# MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< MESSENGER ###
###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://${PROJECT_NAME}-mailer:1025
MAILER_FROM=noreply@localhost
###< symfony/mailer ###

###> florimond/log-bundle ###
# Base de logs (EM `log`). Même hôte que ci-dessus, et le mot de passe est bien
# celui de root : `password` est celui de l'utilisateur `user`, jamais utilisé.
LOG_DATABASE_URL=mysql://root:${MYSQL_ROOT_PASSWORD}@${PROJECT_NAME}-db:3306/app_log?serverVersion=mariadb-10.11.15&charset=utf8mb4
# Valeur bidon : `setup.sh` en génère une aléatoire dans .env.local.
FLORIMOND_LOG_IP_PSEUDONYMIZER_PEPPER=ChangeThisToARandomSecret
###< florimond/log-bundle ###
