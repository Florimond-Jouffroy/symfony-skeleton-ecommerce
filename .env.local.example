# Exemple de .env.local — le vrai fichier est GÉNÉRÉ par `make setup` (gitignoré).
# Il n'est là que pour documenter ce que le setup écrit, et pour dépanner une
# configuration cassée. Les valeurs `<projet>` sont remplacées par le nom de
# projet saisi au setup.

# --- BASES DE DONNÉES (DOCTRINE) ---
# L'hôte est le NOM DU CONTENEUR (`<projet>-db`), pas le nom de service
# `database` : tous les projets partagent le réseau `gateway`, où seul le nom de
# conteneur est unique.
DATABASE_URL="mysql://root:root@<projet>-db:3306/app_main?serverVersion=mariadb-10.11.15&charset=utf8mb4"
LOG_DATABASE_URL="mysql://root:root@<projet>-db:3306/app_log?serverVersion=mariadb-10.11.15&charset=utf8mb4"

# Pas d'URL de test à définir : en environnement `test`, Doctrine suffixe ces
# deux bases en `app_main_test` / `app_log_test` (dbname_suffix, voir
# config/packages/doctrine.yaml).

# --- SECRETS PROPRES AU PROJET (générés aléatoirement par le setup) ---
# Ne jamais les partager entre deux projets ni les committer.
APP_SECRET="<64 caractères hexadécimaux>"
FLORIMOND_LOG_IP_PSEUDONYMIZER_PEPPER="<64 caractères hexadécimaux>"

# --- DIVERS ---
# Nom du site exposé par le FlorimondCoreBundle
FLORIMOND_CORE_SITE_NAME="<projet>"

# Les e-mails partent vers Mailpit (`smtp://<projet>-mailer:1025`, défini dans
# .env) et se consultent sur http://mail.<projet>.localhost
