# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999

# DATABASE_URL n'est volontairement PAS redéfini ici : il vient de .env (et non
# de .env.local, que Symfony ignore en env test), d'où `app_main_test`.
#
# Base de logs (2e connexion Doctrine) : le suffixe _test est ajouté
# automatiquement en env test. Hôte = nom de conteneur unique (voir .env) pour
# éviter la collision sur l'alias `database` du réseau partagé.
LOG_DATABASE_URL=mysql://root:root@${PROJECT_NAME}-db:3306/app_log?serverVersion=mariadb-10.11.15&charset=utf8mb4

MAILER_FROM=test@localhost
# Transport nul en test : pas de dépendance à un serveur SMTP (Mailpit absent en CI).
# assertEmailCount() fonctionne quand même (emails captés avant le transport).
MAILER_DSN=null://null
