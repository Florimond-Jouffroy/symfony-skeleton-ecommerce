<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Confirmation de commande {{ order.orderNumber }}</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f4f4f4; margin: 0; padding: 0; }
        .container { max-width: 560px; margin: 40px auto; background: #fff; border-radius: 8px; padding: 40px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
        h1 { font-size: 22px; color: #1a1a2e; margin: 0 0 8px; }
        .order-number { font-size: 13px; color: #888; margin-bottom: 24px; }
        p { color: #444; line-height: 1.6; margin: 0 0 16px; }
        table { width: 100%; border-collapse: collapse; margin: 24px 0; }
        th { text-align: left; font-size: 12px; color: #888; text-transform: uppercase; border-bottom: 2px solid #eee; padding: 6px 0; }
        td { padding: 10px 0; border-bottom: 1px solid #f0f0f0; font-size: 14px; color: #333; vertical-align: top; }
        td.right { text-align: right; }
        .totals { margin-top: 8px; }
        .totals tr td { border: none; padding: 4px 0; }
        .totals tr.total td { font-weight: bold; font-size: 16px; color: #1a1a2e; padding-top: 10px; border-top: 2px solid #eee; }
        .address-block { background: #f8f8f8; border-radius: 6px; padding: 16px; margin: 16px 0; font-size: 14px; color: #444; line-height: 1.7; }
        .footer { font-size: 12px; color: #aaa; margin-top: 32px; border-top: 1px solid #eee; padding-top: 16px; text-align: center; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Merci pour votre commande !</h1>
        <div class="order-number">Commande n° {{ order.orderNumber }}</div>

        <p>Bonjour {{ order.customer.firstName }},</p>
        <p>Nous avons bien reçu votre commande et nous la préparons avec soin. Vous recevrez un nouvel e-mail dès qu'elle sera expédiée.</p>

        <table>
            <thead>
                <tr>
                    <th>Article</th>
                    <th class="right">Qté</th>
                    <th class="right">Prix</th>
                </tr>
            </thead>
            <tbody>
                {% for item in order.items %}
                <tr>
                    <td>
                        {{ item.productName }}
                        {% if item.variantName %}
                            <br><span style="color:#888;font-size:12px;">{{ item.variantName }}</span>
                        {% endif %}
                    </td>
                    <td class="right">{{ item.quantity }}</td>
                    <td class="right">{{ (item.total / 100)|number_format(2, ',', ' ') }} €</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <table class="totals">
            <tr>
                <td>Sous-total</td>
                <td class="right">{{ (order.subtotal / 100)|number_format(2, ',', ' ') }} €</td>
            </tr>
            {% if order.discountAmount > 0 %}
            <tr>
                <td>Réduction{% if order.promoCode %} ({{ order.promoCode }}){% endif %}</td>
                <td class="right" style="color:#2a9d5c;">− {{ (order.discountAmount / 100)|number_format(2, ',', ' ') }} €</td>
            </tr>
            {% endif %}
            <tr>
                <td>Livraison</td>
                <td class="right">
                    {% if order.shippingAmount == 0 %}
                        Offerte
                    {% else %}
                        {{ (order.shippingAmount / 100)|number_format(2, ',', ' ') }} €
                    {% endif %}
                </td>
            </tr>
            <tr class="total">
                <td>Total</td>
                <td class="right">{{ (order.total / 100)|number_format(2, ',', ' ') }} €</td>
            </tr>
        </table>

        {% set addr = order.shippingAddress %}
        <p><strong>Adresse de livraison</strong></p>
        <div class="address-block">
            {{ addr.firstName }} {{ addr.lastName }}<br>
            {{ addr.line1 }}
            {% if addr.line2 is defined and addr.line2 %}
                <br>{{ addr.line2 }}
            {% endif %}
            <br>{{ addr.postalCode }} {{ addr.city }}<br>
            {{ addr.country|default('France') }}
        </div>

        <div class="footer">
            {{ company.name }} — {{ company.address1 }}, {{ company.postal_code }} {{ company.city }}<br>
            Des questions ? Contactez-nous à <a href="mailto:{{ company.email }}">{{ company.email }}</a>
        </div>
    </div>
</body>
</html>
