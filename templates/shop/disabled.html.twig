{% extends 'layout/public_base.html.twig' %}

{% block title %}Boutique temporairement indisponible — {{ company.name }}{% endblock %}

{% block content %}
<div class="flex flex-col items-center justify-center min-h-[60vh] px-4 text-center">
    <div class="space-y-6 max-w-md">

        <div class="flex justify-center">
            <div class="flex h-16 w-16 items-center justify-center rounded-full bg-muted">
                <svg class="h-8 w-8 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5V6.75a4.5 4.5 0 1 1 9 0v3.75M3.75 21.75h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H3.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                </svg>
            </div>
        </div>

        <div class="space-y-2">
            <h1 class="text-2xl font-bold tracking-tight">Boutique temporairement indisponible</h1>
            <p class="text-muted-foreground">
                Notre boutique est momentanément fermée. Revenez bientôt, nous travaillons à vous offrir la meilleure expérience possible.
            </p>
        </div>

        <a href="{{ path('app_home') }}"
           class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-primary text-primary-foreground text-sm font-medium hover:bg-primary/90 transition-colors">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
            Retour à l'accueil
        </a>

    </div>
</div>
{% endblock %}
