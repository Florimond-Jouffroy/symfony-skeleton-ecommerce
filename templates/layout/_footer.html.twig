<footer class="mt-auto border-t border-border bg-background">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-12">
        <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">

            {# ── Colonne 1 : Marque ── #}
            <div class="space-y-4 lg:col-span-1">
                <a href="{{ path('app_home') }}"
                   class="inline-flex items-center gap-2.5 font-semibold text-foreground hover:opacity-75 transition-opacity">
                    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground text-sm font-black shadow-sm">
                        B
                    </div>
                    <span class="text-[15px] tracking-tight">{{ company.name }}</span>
                </a>
                <p class="text-sm text-muted-foreground leading-relaxed max-w-xs">
                    Une boutique en ligne simple et élégante, pensée pour vous faciliter la vie.
                </p>
            </div>

            {# ── Colonne 2 : Navigation ── #}
            <div class="space-y-4">
                <h3 class="text-sm font-semibold text-foreground">Navigation</h3>
                <ul class="space-y-2.5 text-sm">
                    <li>
                        <a href="{{ path('app_home') }}"
                           class="text-muted-foreground hover:text-foreground transition-colors">
                            Accueil
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('blog_index') }}"
                           class="text-muted-foreground hover:text-foreground transition-colors">
                            Blog
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('shop_index') }}"
                           class="text-muted-foreground hover:text-foreground transition-colors">
                            Boutique
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('faq_index') }}"
                           class="text-muted-foreground hover:text-foreground transition-colors">
                            FAQ
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('contact_index') }}"
                           class="text-muted-foreground hover:text-foreground transition-colors">
                            Contact
                        </a>
                    </li>
                </ul>
            </div>

            {# ── Colonne 3 : Compte ── #}
            <div class="space-y-4">
                <h3 class="text-sm font-semibold text-foreground">Mon compte</h3>
                <ul class="space-y-2.5 text-sm">
                    {% if app.user %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <li>
                                <a href="{{ path('app_admin') }}"
                                   class="text-muted-foreground hover:text-foreground transition-colors">
                                    Administration
                                </a>
                            </li>
                        {% endif %}
                        <li>
                            <a href="{{ path('app_security_logout') }}"
                               class="text-muted-foreground hover:text-foreground transition-colors">
                                Se déconnecter
                            </a>
                        </li>
                    {% else %}
                        <li>
                            <a href="{{ path('app_security_login') }}"
                               class="text-muted-foreground hover:text-foreground transition-colors">
                                Connexion
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('app_security_register') }}"
                               class="text-muted-foreground hover:text-foreground transition-colors">
                                Créer un compte
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>

            {# ── Colonne 4 : Contact ── #}
            <div class="space-y-4">
                <h3 class="text-sm font-semibold text-foreground">Contact</h3>
                <ul class="space-y-2.5 text-sm text-muted-foreground">
                    <li class="flex items-center gap-2">
                        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                        </svg>
                        {{ company.email }}
                    </li>
                </ul>
            </div>

        </div>

        {# ── Bas de page ── #}
        <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-border pt-8 sm:flex-row">
            <p class="text-xs text-muted-foreground">
                © {{ "now"|date("Y") }} {{ company.name }}. Tous droits réservés.
            </p>
            <div class="flex items-center gap-1 text-xs text-muted-foreground">
                <a href="{{ path('static_page_show', {slug: 'mentions-legales'}) }}" class="hover:text-foreground transition-colors">Mentions légales</a>
                <span class="select-none">·</span>
                <a href="{{ path('static_page_show', {slug: 'politique-de-confidentialite'}) }}" class="hover:text-foreground transition-colors">Politique de confidentialité</a>
                <span class="select-none">·</span>
                <a href="{{ path('static_page_show', {slug: 'cgv'}) }}" class="hover:text-foreground transition-colors">CGV</a>
                <span class="select-none">·</span>
                <a href="{{ path('faq_index') }}" class="hover:text-foreground transition-colors">FAQ</a>
            </div>
        </div>
    </div>
</footer>
